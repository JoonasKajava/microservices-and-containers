{
	http_port 8080
	https_port 8443
}

(tinyauth_forwarder) {
	forward_auth tinyauth:3000 {
		uri /api/auth/caddy
		copy_headers Remote-User Remote-Name Remote-Email Remote-Groups
	}
}

http://auth.equipment.localhost:8080 {
	reverse_proxy tinyauth:3000
}

http://equipment.localhost:8080 {
	import tinyauth_forwarder
	respond "hellow world"
}
